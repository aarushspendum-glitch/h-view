# Copy to .env for local `vercel dev` testing. In production, set these
# in the Vercel dashboard: Project Settings -> Environment Variables.
# Never commit the real values.

# Supabase project URL (Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co

# Prefer the service_role key here, NOT the anon key, once Row Level
# Security is locked down on users/devices/readings/sessions -- the
# anon key is subject to RLS and safe to expose client-side, but
# service_role bypasses RLS entirely and must stay server-side only.
SUPABASE_KEY=your-service-role-or-anon-key

# Shared secret required by /api/register and /api/assign-device.
# Generate something long and random, not the placeholder below.
ADMIN_SECRET=change-me
