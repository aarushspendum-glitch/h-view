# Copy to .env for local `vercel dev` testing. In production, set these
# in the Vercel dashboard: Project Settings -> Environment Variables.
# Never commit the real values.

# Supabase project URL (Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co

# Prefer the service_role key here, NOT the anon key, once Row Level
# Security is locked down on users/devices/readings/sessions -- the
# anon key is subject to RLS and safe to expose client-side, but
# service_role bypasses RLS entirely and must stay server-side only.
SUPABASE_KEY=your-service-role-or-anon-key

# Shared secret required by /api/register and /api/assign-device, as a
# second factor alongside an authenticated admin session (Phase 2).
# Generate something long and random, not the placeholder below.
ADMIN_SECRET=change-me

# Required by /api/check-device-health -- without this set, the endpoint
# rejects every request rather than silently allowing unauthenticated
# access. Vercel Cron sends this automatically once configured; also needed
# to manually trigger the check yourself (see README).
CRON_SECRET=change-me

# Where device-silence alerts from /api/check-device-health get sent.
# Must match your Resend account's own verified/registered email while
# using Resend's sandbox sender -- otherwise delivery silently fails.
ADMIN_ALERT_EMAIL=you@example.com

# Per-device auth secrets are generated automatically by /api/assign-device
# on first provisioning (stored hashed, shown once) -- no env var needed.
